# Copie para .env e preencha. Nenhum valor real deve ser versionado.

# -----------------------------------------------------------------------------
# BANCO E AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Conexão que a aplicação usa. No Neon, o host COM "-pooler".
DATABASE_URL="postgresql://user:senha@ep-exemplo-pooler.us-east-1.aws.neon.tech/omniapp?sslmode=require"
# Conexão direta, usada só por prisma migrate. No Neon, o MESMO host SEM "-pooler".
# Em ambiente local sem pooler, repita o valor de DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:senha@ep-exemplo.us-east-1.aws.neon.tech/omniapp?sslmode=require"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# MENSAGERIA (QStash) — sem estas variáveis as rotas de job respondem 503
# -----------------------------------------------------------------------------
# Origem pública da aplicação, https e sem caminho: é a base do destino assinado
# que o QStash chama e contra o qual a assinatura é verificada.
APP_URL="https://app.exemplo.com.br"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# OBRIGATÓRIA quando o projeto QStash é regional: o endpoint global responde 404
# para esses projetos, e a publicação falha com PUBLISH_FAILED. Copie a URL que o
# console mostra na região escolhida.
QSTASH_URL="https://qstash-us-east-1.upstash.io"

# Autentica o agendador que chama /api/jobs/dispatch-outbox. Mínimo de 32 caracteres.
# openssl rand -base64 32
CRON_SECRET=""

# -----------------------------------------------------------------------------
# INTEGRAÇÕES
# -----------------------------------------------------------------------------
# Chave AES-256 dos tokens das conexões: exatamente 32 bytes em base64.
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# Segredo no caminho do webhook: /api/webhooks/mercadolivre/<segredo>.
# Mínimo de 32 caracteres. openssl rand -hex 16
#
# NÃO use -hex 32 aqui: o campo de URL de notificações do DevCenter corta em
# 120 caracteres, e com 64 de segredo a URL fica com 122. O corte é silencioso
# -- o portal salva e mostra a URL truncada como se estivesse certa -- e toda
# notificação passa a bater num 404. Com 32 de segredo a URL fica em 90.
MERCADO_LIVRE_WEBHOOK_SECRET=""
# ID da aplicação no DevCenter. Serve de client_id no OAuth e também descarta
# avisos de outra aplicação que cheguem ao webhook.
MERCADO_LIVRE_APP_ID=""
# Secret da aplicação, usado só na troca do código por token.
MERCADO_LIVRE_APP_SECRET=""
# Só se o Mercado Livre mudar os endpoints: os padrões do código são
# https://auth.mercadolivre.com.br/authorization e
# https://api.mercadolibre.com/oauth/token. Aceita apenas domínio do ML.
# MERCADO_LIVRE_AUTH_URL=""
# MERCADO_LIVRE_TOKEN_URL=""
# Escopos na URL de autorização. Valores permitidos pelo ML: offline_access,
# read e write. offline_access é o que faz vir o refresh_token; sem ele a
# conexão expira em seis horas e exige reautorizar na mão. Padrão do código:
# "offline_access read write". Defina vazio para não mandar o parâmetro.
# MERCADO_LIVRE_SCOPE=""

# Shopee (Open Platform, API v2).
# partner_id e partner_key saem do console da Open Platform, e criar o app exige
# conta de desenvolvedor APROVADA -- no Brasil, com CNPJ: o tipo
# "Individual Seller" está fechado para BR. Sem estas duas, a tela não oferece
# o botão de autorizar em vez de deixar o clique cair num erro.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
# true aponta para o sandbox (partner.test-stable.shopeemobile.com). O
# partner_id do sandbox é OUTRO, não o mesmo da produção.
SHOPEE_SANDBOX="true"
# Só se a Shopee mudar o host. Padrões do código: partner.shopeemobile.com em
# produção e partner.test-stable.shopeemobile.com no sandbox.
# SHOPEE_HOST=""
# Segredo no caminho do push: /api/webhooks/shopee/<segredo>.
# Mínimo de 32 caracteres. Use `openssl rand -hex 16` -- 32 caracteres, e não 64:
# console de provedor costuma truncar URL, e foi assim que perdemos um dia com o
# Mercado Livre (a URL cortava em 120 caracteres e todo aviso dava 404).
SHOPEE_WEBHOOK_SECRET=""
# Confere também a assinatura que a Shopee põe no header Authorization do push.
# Nasce desligada de propósito: a construção dessa assinatura não foi medida, e
# um palpite errado derrubaria TODO aviso com 404 -- com o sintoma de "nenhum
# pedido chegou". Ligue depois de ver aviso chegando.
SHOPEE_VERIFY_PUSH="false"
# Peso do pacote, em quilos. É dado de logística, não de produto: o catálogo não
# guarda peso e a Shopee exige um na criação do anúncio.
SHOPEE_DEFAULT_WEIGHT_KG="0.5"

# OLX (API de anúncios / autoupload).
# ATENÇÃO: a OLX é CLASSIFICADOS. Ela publica anúncio e não tem API de pedido --
# a venda acontece no telefone ou no chat, fora da plataforma. Este canal
# participa só da jornada de saída; conciliação e aviso de pedido não existem.
# client_id e client_secret saem de aprovação manual (suporteintegrador@olxbr.com)
# e exigem plano empresarial: a API é vedada a plano de autônomo.
OLX_CLIENT_ID=""
OLX_CLIENT_SECRET=""
# Escopos. Padrão do código: "basic_user_info autoupload". basic_user_info é o
# que identifica a conta -- o token da OLX não traz identificador nenhum.
# OLX_SCOPE=""
# Só se a OLX mudar os endpoints. Padrões: https://auth.olx.com.br/oauth,
# https://auth.olx.com.br/oauth/token e https://apps.olx.com.br.
# OLX_AUTH_URL=""
# OLX_TOKEN_URL=""
# OLX_API_URL=""
# Caminho de basic_user_info, que não pudemos confirmar na documentação. Se a
# autorização falhar dizendo que não identificou a conta, é aqui que se corrige.
# OLX_USER_INFO_PATH="/oauth_api/basic_user_info"
# Telefone e CEP do anunciante NÃO ficam aqui: eles são de UMA organização, e o
# mesmo deploy atende várias -- uma variável de ambiente serviria a todas ao
# mesmo tempo, e o anúncio de uma sairia com o telefone da outra. Estão no
# cadastro da organização, na tela de Organizações, e são lidos pela
# organização do produto que está sendo publicado.

# Sebo On-Line (loja própria), integrado pelo mesmo caminho dos marketplaces.
# Base da API atrás do gateway, https; o prefixo de caminho é preservado.
SEBO_API_URL="https://gateway.exemplo.com/sebo/api"
# Segredo no caminho do webhook: /api/webhooks/sebo/<segredo>.
# Mínimo de 32 caracteres. openssl rand -hex 32
SEBO_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# SEED
# -----------------------------------------------------------------------------
SEED_ORG_NAME="Org Demo"
SEED_ADMIN_EMAIL="admin@local.test"
SEED_ADMIN_PASSWORD=""
SEED_PLATFORM_ADMIN_EMAIL="plataforma@local.test"
SEED_PLATFORM_ADMIN_PASSWORD=""
