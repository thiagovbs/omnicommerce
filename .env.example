# Copie para .env e preencha. Nenhum valor real deve ser versionado.

# -----------------------------------------------------------------------------
# BANCO E AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Conexão que a aplicação usa. No Neon, o host COM "-pooler".
DATABASE_URL="postgresql://user:senha@ep-exemplo-pooler.us-east-1.aws.neon.tech/omniapp?sslmode=require"
# Conexão direta, usada só por prisma migrate. No Neon, o MESMO host SEM "-pooler".
# Em ambiente local sem pooler, repita o valor de DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:senha@ep-exemplo.us-east-1.aws.neon.tech/omniapp?sslmode=require"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# MENSAGERIA (QStash) — sem estas variáveis as rotas de job respondem 503
# -----------------------------------------------------------------------------
# Origem pública da aplicação, https e sem caminho: é a base do destino assinado
# que o QStash chama e contra o qual a assinatura é verificada.
APP_URL="https://app.exemplo.com.br"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# OBRIGATÓRIA quando o projeto QStash é regional: o endpoint global responde 404
# para esses projetos, e a publicação falha com PUBLISH_FAILED. Copie a URL que o
# console mostra na região escolhida.
QSTASH_URL="https://qstash-us-east-1.upstash.io"

# Autentica o agendador que chama /api/jobs/dispatch-outbox. Mínimo de 32 caracteres.
# openssl rand -base64 32
CRON_SECRET=""

# -----------------------------------------------------------------------------
# INTEGRAÇÕES
# -----------------------------------------------------------------------------
# Chave AES-256 dos tokens das conexões: exatamente 32 bytes em base64.
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# Segredo no caminho do webhook: /api/webhooks/mercadolivre/<segredo>.
# Mínimo de 32 caracteres. openssl rand -hex 32
MERCADO_LIVRE_WEBHOOK_SECRET=""
# ID da aplicação no DevCenter. Serve de client_id no OAuth e também descarta
# avisos de outra aplicação que cheguem ao webhook.
MERCADO_LIVRE_APP_ID=""
# Secret da aplicação, usado só na troca do código por token.
MERCADO_LIVRE_APP_SECRET=""
# Só se o Mercado Livre mudar os endpoints: os padrões do código são
# https://auth.mercadolivre.com.br/authorization e
# https://api.mercadolibre.com/oauth/token. Aceita apenas domínio do ML.
# MERCADO_LIVRE_AUTH_URL=""
# MERCADO_LIVRE_TOKEN_URL=""
# Escopos pedidos na autorização. O padrão do código é "offline_access read
# write"; offline_access é o que faz o provedor emitir refresh token. Defina
# como vazio para não mandar o parâmetro.
# MERCADO_LIVRE_SCOPE=""

# Sebo On-Line (loja própria), integrado pelo mesmo caminho dos marketplaces.
# Base da API atrás do gateway, https; o prefixo de caminho é preservado.
SEBO_API_URL="https://gateway.exemplo.com/sebo/api"
# Segredo no caminho do webhook: /api/webhooks/sebo/<segredo>.
# Mínimo de 32 caracteres. openssl rand -hex 32
SEBO_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# SEED
# -----------------------------------------------------------------------------
SEED_ORG_NAME="Org Demo"
SEED_ADMIN_EMAIL="admin@local.test"
SEED_ADMIN_PASSWORD=""
SEED_PLATFORM_ADMIN_EMAIL="plataforma@local.test"
SEED_PLATFORM_ADMIN_PASSWORD=""
