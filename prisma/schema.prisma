generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão pooled: é a que a aplicação usa (no Neon, o host com -pooler).
  url       = env("DATABASE_URL")
  // Conexão direta: migrations não funcionam através de pooler em modo transaction.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  PLATFORM_ADMIN
}

enum SaleStatus {
  CREATED
  PAID
  INVOICED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SaleSource {
  MANUAL
  INTEGRATION
}

enum SaleStatusChangeSource {
  MANUAL
  INTEGRATION
  INITIALIZATION
}

enum AuditActorType {
  USER
  INTEGRATION
}

enum MarketplaceProvider {
  MERCADO_LIVRE
  SHOPEE
  SEBO_ONLINE
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum IntegrationEventStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// Por que o estoque mudou. Sem isso, uma baixa por venda seria
/// indistinguível de um ajuste manual no histórico.
enum StockMovementReason {
  CREATION
  MANUAL
  PRODUCT_EDIT
  SALE
  CANCELLATION
}

/// Estado de um anúncio num canal. PUBLISHING existe para separar "pedimos
/// para publicar" de "o provedor confirmou": sem isso, uma falha no meio
/// deixaria o anúncio parecendo rascunho e ele seria publicado duas vezes.
enum ListingStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
  PAUSED
  CLOSED
}

enum Currency {
  BRL
  USD
  EUR
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  users        User[]
  marketplaces Marketplace[]
  sales        Sale[]
  products     Product[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String?
  role           UserRole @default(OPERATOR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  saleStatusChanges SaleStatusHistory[]

  @@index([organizationId])
}

model Marketplace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales             Sale[]
  integrationEvents IntegrationEvent[]
  connections       MarketplaceConnection[]
  listings          Listing[]
  categories        MarketplaceCategory[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Sale {
  id              String     @id @default(cuid())
  organizationId  String
  marketplaceId   String
  externalOrderId String
  status          SaleStatus
  soldAt          DateTime
  currency        Currency   @default(BRL)

  /// How the order entered OmniCommerce; independent of the marketplace channel.
  source            SaleSource @default(MANUAL)
  /// Original marketplace status, kept separately from the normalized status.
  externalStatus    String?
  /// Timestamp supplied by the marketplace, not the webhook reception time.
  externalUpdatedAt DateTime?
  /// Last successful synchronization with the marketplace.
  lastSyncedAt      DateTime?
  /// Increment atomically when changing status to detect concurrent updates.
  statusVersion     Int        @default(0)

  gross    Decimal @db.Decimal(14, 2)
  shipping Decimal @default(0) @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  fees     Decimal @default(0) @db.Decimal(14, 2)
  net      Decimal @db.Decimal(14, 2)

  customerName  String?
  customerEmail String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace   Marketplace         @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  items         SaleItem[]
  statusHistory SaleStatusHistory[]

  @@unique([marketplaceId, externalOrderId])
  @@index([organizationId])
  @@index([marketplaceId])
  @@index([soldAt])
  @@index([organizationId, status, soldAt])
}

model SaleItem {
  id                  String  @id @default(cuid())
  saleId              String
  sku                 String?
  externalItemId      String?
  externalVariationId String?
  title               String
  quantity            Int
  unitPrice           Decimal @db.Decimal(14, 2)
  total               Decimal @db.Decimal(14, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

/// Append-only status journal. Organization is resolved through Sale.
/// Write the order status and this entry in the same database transaction.
model SaleStatusHistory {
  id              String                 @id @default(cuid())
  saleId          String
  fromStatus      SaleStatus?
  toStatus        SaleStatus
  source          SaleStatusChangeSource
  /// Version 0 is the initial snapshot; subsequent changes increment the version.
  version         Int
  /// Namespaced provider event identifier. Null for manual changes/snapshots.
  externalEventId String?
  externalStatus  String?
  /// When the change occurred at the source; unknown for legacy snapshots.
  occurredAt      DateTime?
  /// When OmniCommerce recorded the entry.
  recordedAt      DateTime               @default(now())
  changedById     String?
  reason          String?

  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([saleId, version])
  @@unique([saleId, externalEventId])
  @@index([saleId, recordedAt])
  @@index([changedById])
}

model AuditLog {
  id                 String            @id @default(cuid())
  action             String // ex: "CREATE_SALE", "UPDATE_USER"
  entity             String // ex: "Sale", "Marketplace"
  entityId           String
  details            String?
  oldData            Json? // Estado antes da mudança
  newData            Json? // Estado depois da mudança
  actorType          AuditActorType    @default(USER)
  userId             String?
  user               User?             @relation(fields: [userId], references: id)
  integrationEventId String?
  integrationEvent   IntegrationEvent? @relation(fields: [integrationEventId], references: [id], onDelete: SetNull)
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: id)
  createdAt          DateTime          @default(now())

  @@index([integrationEventId])
}

/// Raw provider notification as received. The processing job resolves it into an order
/// snapshot through the provider adapter; nothing here is trusted as normalized data.
model IntegrationEvent {
  id              String                 @id @default(cuid())
  marketplaceId   String
  /// Authorized account the notification arrived for. Null for events recorded without one.
  connectionId    String?
  externalEventId String
  externalOrderId String
  payload         Json
  status          IntegrationEventStatus @default(PENDING)
  attempts        Int                    @default(0)
  lastError       String?
  receivedAt      DateTime               @default(now())
  processedAt     DateTime?
  marketplace     Marketplace            @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  connection      MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  outbox          OutboxMessage?
  auditLogs       AuditLog[]

  @@unique([marketplaceId, externalEventId])
  @@index([marketplaceId, externalOrderId])
  @@index([status, receivedAt])
  @@index([connectionId])
}

/// One authorized seller account on a provider. Credentials are stored encrypted and are
/// never sent to the browser; the organization is resolved through the marketplace.
model MarketplaceConnection {
  id                String              @id @default(cuid())
  marketplaceId     String
  provider          MarketplaceProvider
  /// Seller/shop identifier at the provider (Mercado Livre user_id, Shopee shop_id).
  externalAccountId String
  status            ConnectionStatus    @default(ACTIVE)
  /// AES-256-GCM ciphertext. Never log, never return in a server action payload.
  accessToken       String?
  refreshToken      String?
  /// Access token expiry as reported by the provider.
  expiresAt         DateTime?
  lastSyncedAt      DateTime?
  /// Até quando a conciliação já varreu este provedor. Separado de
  /// `lastSyncedAt`, que avança com qualquer aviso entregue: se a janela
  /// dependesse dele, um aviso recente empurraria o ponto de partida para
  /// frente e o pedido cujo aviso se perdeu ficaria fora para sempre.
  lastReconciledAt  DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  marketplace       Marketplace        @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  integrationEvents IntegrationEvent[]
  listings          Listing[]

  /// A provider account belongs to exactly one connection, so a notification maps to one tenant.
  @@unique([provider, externalAccountId])
  @@index([marketplaceId])
}

model OutboxMessage {
  id          String           @id @default(cuid())
  eventId     String           @unique
  status      OutboxStatus     @default(PENDING)
  attempts    Int              @default(0)
  availableAt DateTime         @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime         @default(now())
  event       IntegrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, leaseUntil])
}

/// Catálogo da organização: a fonte da verdade de preço e estoque.
///
/// O que está aqui é o que DEVERIA estar em cada canal. Os canais guardam o
/// que já foi confirmado (ver Listing), e a diferença entre os dois é o que o
/// sincronizador tem para fazer.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  /// Identificação do produto para quem opera. É a chave que liga um item de
  /// venda que chega do marketplace de volta ao catálogo.
  sku            String
  title          String
  description    String   @default("")
  category       String   @default("")
  brand          String   @default("")
  /// Novo, usado, seminovo. Texto livre porque cada canal nomeia do seu jeito.
  condition      String   @default("")
  price          Decimal  @db.Decimal(14, 2)
  currency       Currency @default(BRL)
  stock          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings     Listing[]
  movements    StockMovement[]
  images       ProductImage[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, active])
}

/// Um produto publicado (ou a publicar) num canal.
///
/// `publishedPrice` e `publishedStock` são o que o provedor confirmou, não o
/// que queremos. Guardá-los aqui é o que permite decidir o que sincronizar sem
/// perguntar ao provedor, e é o que faz a sincronização ser idempotente: o
/// trabalhador manda o valor absoluto do produto, nunca uma diferença.
model Listing {
  id                   String        @id @default(cuid())
  productId            String
  marketplaceId        String
  status               ListingStatus @default(DRAFT)
  /// Em qual conta do provedor este anúncio é publicado.
  ///
  /// Um canal pode ter mais de uma conta conectada -- uma real e uma de teste,
  /// por exemplo. Sem registrar a escolha, a publicação caía num `findFirst`
  /// sem critério e podia ir para a conta errada sem aviso nenhum.
  connectionId         String?
  /// Identificador do anúncio no provedor. Só existe depois de publicado.
  externalListingId    String?
  /// O estado do anúncio segundo o PROVEDOR, com as palavras dele.
  ///
  /// Não é o nosso `status`: o nosso diz se conseguimos entregar, o dele diz
  /// se o anúncio está no ar. O Mercado Livre aceita a criação e devolve
  /// `under_review` -- tratar isso como publicado faria a tela dizer que se
  /// está vendendo quando o anúncio nem apareceu.
  externalStatus       String?
  publishedPrice       Decimal?      @db.Decimal(14, 2)
  publishedStock       Int?
  /// Impressão de TUDO que foi enviado ao provedor na última publicação.
  ///
  /// Uma impressão só, e não um campo por atributo, porque a comparação campo
  /// a campo já divergiu duas vezes da lista do que se publica: primeiro as
  /// imagens, depois o título. Nos dois casos o anúncio era marcado como
  /// pendente, o trabalhador o considerava em dia e a mudança nunca chegava ao
  /// provedor -- sem erro nenhum. Com a impressão, esquecer um campo é
  /// impossível: ou ele entra no que se envia, ou não existe.
  ///
  /// Guarda a impressão e não os valores porque uma imagem enviada é um data
  /// URI de megabytes.
  publishedFingerprint String?
  /// Categoria escolhida neste canal, no identificador do provedor.
  ///
  /// Mora no anúncio porque é por canal: o mesmo produto pode ser "Livros" no
  /// Mercado Livre e outra coisa noutro marketplace. O campo livre `category`
  /// do produto continua existindo para quem não tem árvore de categorias.
  categoryExternalId   String?
  /// A categoria enviada ao provedor na última publicação.
  publishedCategoryId  String?
  lastPublishedAt      DateTime?
  /// Há trabalho a fazer neste anúncio. Ligada quando o produto muda ou quando
  /// se pede publicação; desligada quando o provedor confirma. Sem ela o
  /// trabalhador teria que varrer todo anúncio publicado a cada rodada só para
  /// descobrir que nada mudou.
  needsSync            Boolean       @default(true)
  /// Quando tentar de novo depois de falhar. Backoff exponencial.
  availableAt          DateTime      @default(now())
  attempts             Int           @default(0)
  lastError            String?
  /// Lease do trabalhador, no mesmo desenho do outbox de entrada.
  leaseUntil           DateTime?
  leaseToken           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace Marketplace            @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  /// Restrict: apagar a conexão deixaria o anúncio sem saber onde está publicado.
  connection  MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Um produto tem no máximo um anúncio por canal.
  @@unique([productId, marketplaceId])
  @@index([marketplaceId])
  @@index([needsSync, availableAt])
}

/// Cada mudança de estoque, com o saldo que ficou depois dela.
///
/// Guardar o `balance` junto do `delta` evita reconstruir o saldo somando a
/// série inteira toda vez que alguém abre o painel, e deixa o registro legível
/// sozinho: a linha diz o que aconteceu e onde parou.
///
/// Gravado na mesma transação da mudança. Antes disto, uma venda baixava o
/// estoque sem deixar rastro em lugar nenhum -- nem na auditoria.
model StockMovement {
  id             String              @id @default(cuid())
  productId      String
  /// Repetida aqui de propósito: o painel filtra por organização e período, e
  /// sem a coluna todo gráfico exigiria juntar com Product.
  organizationId String
  /// Negativo é saída. A soma dos deltas posteriores a um dia reconstrói
  /// exatamente o saldo daquele dia a partir do saldo de hoje.
  delta          Int
  balance        Int
  reason         StockMovementReason
  /// Presente quando o movimento veio de uma venda.
  saleId         String?
  createdAt      DateTime            @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
}

/// Álbum de imagens do produto.
///
/// Fica no produto, e não em cada anúncio: a foto é do item, não do canal, e
/// um álbum por canal obrigaria a reenviar as mesmas imagens em cada um.
/// Quem decide quantas usar é o adapter do provedor — os que aceitam uma só
/// levam a posição 0.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  /// Ordem no álbum, começando em zero. A posição 0 é a principal.
  position  Int
  /// URL https ou data URI em base64 do arquivo enviado.
  url       String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Duas imagens não ocupam a mesma posição: sem isso, "a principal" ficaria
  /// ambígua e dependeria da ordem que o banco devolvesse.
  @@unique([productId, position])
  @@index([productId])
}

/// Árvore de categorias de um canal, copiada do provedor.
///
/// Guardada por canal e não por provedor: dois canais podem apontar para sites
/// diferentes do mesmo provedor (MLB, MLA), e a árvore de um não serve ao
/// outro. O identificador é o do provedor, não um nosso.
model MarketplaceCategory {
  id               String   @id @default(cuid())
  marketplaceId    String
  /// Identificador no provedor, como MLB1051.
  externalId       String
  name             String
  /// Nulo na raiz. É o que permite descer um nível de cada vez na tela.
  parentExternalId String?
  /// Só folha aceita anúncio; intermediária existe para navegar até ela.
  leaf             Boolean
  /// Caminho legível completo, com os nomes separados por " > ". É o que a
  /// busca por texto varre e o que a tela mostra depois de escolhida.
  path             String
  /// Zero na raiz. A árvore do MLB chega a 7 níveis.
  depth            Int
  /// O provedor pode fechar uma categoria para novas publicações.
  listingAllowed   Boolean  @default(true)
  syncedAt         DateTime

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, externalId])
  @@index([marketplaceId, parentExternalId])
  @@index([marketplaceId, leaf])
}
